# Docker-specific overrides for development
# Copy to .env.development.docker (no changes needed for default setup)
#
# These override values from .env.development when running in Docker.
# Why needed: Inside Docker containers, "localhost" refers to the container itself,
# not the host machine. We must use the Docker service name (postgres-dev) instead.

# Database connection for Docker networking
# - Host: postgres-dev (Docker service name, not localhost)
# - Port: 5432 (internal Docker port, not 5433 host-mapped port)
NINJABOT_ConnectionStrings__NinjaBot=Host=postgres-dev;Port=5432;Database=ninjabot_test;Username=ninjabot_test;Password=test_password_local_only;Include Error Detail=true
