    {
      "annotations": {
        "recovery": "Error signal cleared; this does not prove application health.",
        "summary": "NinjaBot core: at least 5 error lines in 10 minutes, sustained for 5 minutes."
      },
      "condition": "B",
      "data": [
        {
          "datasourceUid": "afdlfkc5oc1s0e",
          "model": {
            "datasource": {
              "type": "loki",
              "uid": "afdlfkc5oc1s0e"
            },
            "editorMode": "code",
            "expr": "sum(count_over_time({container=\"/ninjabot\"} |~ \"( ERR]| FTL]|^fail:|^crit:)\" !~ \"Shard [0-9]+ disconnected:\" [10m])) or vector(0)",
            "instant": true,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "queryType": "instant",
            "range": false,
            "refId": "A"
          },
          "queryType": "instant",
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          }
        },
        {
          "datasourceUid": "__expr__",
          "model": {
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "$A >= 5",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "B",
            "type": "math"
