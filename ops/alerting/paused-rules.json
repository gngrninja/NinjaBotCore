      "annotations": {
        "recovery": "An authenticated WCL API success was observed with no newer or tied unavailable marker in the lookback.",
        "summary": "NinjaBot core WCL authentication remains unavailable after recovery attempts."
      },
      "condition": "B",
      "data": [
        {
          "datasourceUid": "afdlfkc5oc1s0e",
          "model": {
            "datasource": {
              "type": "loki",
              "uid": "afdlfkc5oc1s0e"
            },
            "editorMode": "code",
            "expr": "(max(max_over_time({container=\"/ninjabot\"} |= \"[WCL Auth] state=unavailable\" | label_format event_ts=\"{{ __timestamp__ | unixEpochNanos }}\" | unwrap event_ts | __error__=\"\" [24h])) or (max(max_over_time({container=\"/ninjabot\"} |= \"[WCL Auth] state=recovered\" | label_format event_ts=\"{{ __timestamp__ | unixEpochNanos }}\" | unwrap event_ts | __error__=\"\" [24h])) * 0)) >= bool (max(max_over_time({container=\"/ninjabot\"} |= \"[WCL Auth] state=recovered\" | label_format event_ts=\"{{ __timestamp__ | unixEpochNanos }}\" | unwrap event_ts | __error__=\"\" [24h])) or vector(0))",
