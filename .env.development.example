# Development Environment Example
# Copy this to .env.development and fill in your values
#
# Usage:
#   ./run-bot-dev.sh          # Run in Docker (recommended, matches prod)
#   ./run-bot-dev.sh --local  # Run locally against Docker DB
#
# Note: Docker mode also uses .env.development.docker for container networking overrides.
# That file is auto-created from .env.development.docker.example on first run.

# =============================================================================
# REQUIRED - Discord Bot Token
# =============================================================================
# Get from https://discord.com/developers/applications
NINJABOT_Token=your-discord-bot-token-here

# =============================================================================
# OPTIONAL - WoW API Credentials
# =============================================================================
# Only needed if testing WoW features
NINJABOT_WoWClient=your-wow-client-id
NINJABOT_WoWSecret=your-wow-client-secret

# =============================================================================
# OPTIONAL - WarcraftLogs API Credentials
# =============================================================================
# Only needed if testing WCL features
NINJABOT_WarcraftLogsApiCmd=your-warcraftlogs-api-cmd-key
NINJABOT_WarcraftLogsApi=your-warcraftlogs-api-key
NINJABOT_WCLClientId=your-wcl-v2-client-id
NINJABOT_WCLClientSecret=your-wcl-v2-client-secret

# =============================================================================
# OPTIONAL - WarcraftLogs Tier Configuration
# =============================================================================
# Tier 1: Active guilds (recent reports) - checked frequently
NINJABOT_WCL__Tier1ThresholdDays=14
NINJABOT_WCL__Tier1IntervalMinutes=20
# Tier 2: Semi-active guilds - checked periodically
NINJABOT_WCL__Tier2ThresholdDays=30
NINJABOT_WCL__Tier2IntervalHours=3
# Tier 3: Inactive guilds - checked infrequently
NINJABOT_WCL__Tier3IntervalHours=24

# =============================================================================
# DATABASE - Automatically configured by docker-compose.dev.yml
# =============================================================================
# These are OVERRIDDEN by docker-compose.dev.yml in Docker mode.
# Only used in --local mode or if running manually.
NINJABOT_Database__Provider=Postgres
NINJABOT_ConnectionStrings__NinjaBot=Host=localhost;Port=5433;Database=ninjabot_test;Username=ninjabot_test;Password=test_password_local_only;Include Error Detail=true

# =============================================================================
# OPTIONAL - Entity Framework Logging
# =============================================================================
# Set to true to suppress EF Core SQL query logs
NINJABOT_SuppressEFLogs=false

# =============================================================================
# COMMANDS API - Web Dashboard Integration
# =============================================================================
# Exposes REST API for the web dashboard
# Port 5100 is exposed by Docker in both modes
NINJABOT_CommandsApi__Enabled=true
NINJABOT_CommandsApi__Host=0.0.0.0
NINJABOT_CommandsApi__Port=5100
NINJABOT_CommandsApi__ApiKey=dev-api-key-change-in-production
NINJABOT_CommandsApi__AutoRegenerateHours=6

# =============================================================================
# OPTIONAL - YouTube API
# =============================================================================
NINJABOT_YouTubeKey=your-youtube-api-key

# =============================================================================
# OPTIONAL - Steam API
# =============================================================================
NINJABOT_SteamKey=your-steam-api-key
