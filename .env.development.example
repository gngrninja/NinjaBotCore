# Development Environment Example
# Copy this to .env.development and fill in your values

# Discord bot token (REQUIRED - get from https://discord.com/developers/applications)
NINJABOT_Token=your-discord-bot-token-here

# Bot prefix
NINJABOT_prefix=!

# WoW API credentials (optional - only if testing WoW features)
NINJABOT_WoWClient=your-wow-client-id
NINJABOT_WoWSecret=your-wow-client-secret

# Database - Docker test database (DO NOT CHANGE unless you know what you're doing)
NINJABOT_Database__Provider=Postgres
NINJABOT_ConnectionStrings__NinjaBot=Host=localhost;Port=5433;Database=ninjabot_test;Username=ninjabot_test;Password=test_password_local_only;Include Error Detail=true
