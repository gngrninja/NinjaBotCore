# Test Environment Configuration Example
# Copy this to .env.test and customize if needed

# Database provider (Postgres or Sqlite)
NINJABOT_Database__Provider=Postgres

# PostgreSQL connection string for local Docker test database
NINJABOT_ConnectionStrings__NinjaBot=Host=localhost;Port=5433;Database=ninjabot_test;Username=ninjabot_test;Password=test_password_local_only;Include Error Detail=true

# Alternative: Use SQLite for faster tests (not recommended)
# NINJABOT_Database__Provider=Sqlite
# NINJABOT_ConnectionStrings__NinjaBot=Data Source=test.db

# Alternative: Use remote test database
# NINJABOT_Database__Provider=Postgres
# NINJABOT_ConnectionStrings__NinjaBot=Host=njasrv.gngr.ninja;Port=5432;Database=ninjabot_test;Username=ninjabot_test;Password=your_password;SslMode=Require
