# Production Environment Example
# Copy this to .env.production on your server and fill in your values
# DO NOT commit .env.production to git!

# Discord bot token (REQUIRED)
NINJABOT_Token=your-discord-bot-token-here

# Bot prefix
NINJABOT_prefix=!

# WoW API credentials
NINJABOT_WoWClient=your-wow-client-id
NINJABOT_WoWSecret=your-wow-client-secret

# WarcraftLogs API credentials
NINJABOT_WarcraftLogsApiCmd=your-warcraftlogs-api-cmd-key
NINJABOT_WarcraftLogsApi=your-warcraftlogs-api-key

# Database - Production PostgreSQL
NINJABOT_Database__Provider=Postgres
NINJABOT_ConnectionStrings__NinjaBot=Host=prod-server-name;Port=5432;Database=prod-db-name;Username=prod-db-user;Password=your-password;SslMode=Require
